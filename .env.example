DJANGO_SECRET_KEY=dev-secret-key-not-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CELERY_BROKER_URL=redis://redis:6379/0

# Inside Docker, these point at the smtp4dev *service name* and its
# internal SMTP port (25) — not the published host port (2525).
EMAIL_HOST=smtp4dev
EMAIL_PORT=25

# Postgres — service name "postgres", internal port 5432.
POSTGRES_DB=celery_drf_demo
POSTGRES_USER=celery_drf_demo
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
